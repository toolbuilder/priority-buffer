{
  "name": "@toolbuilder/priority-buffer",
  "version": "0.1.6",
  "description": "Priority queue/buffer with capacity limits and custom comparator. Methods push/shift/length match the Array API.",
  "keywords": [
    "priority",
    "queue",
    "buffer"
  ],
  "homepage": "https://github.com/toolbuilder/priority-buffer#readme",
  "bugs": {
    "url": "https://github.com/toolbuilder/priority-buffer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toolbuilder/priority-buffer.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/priority-buffer.js",
  "types": "./src/priority-buffer.d.ts",
  "exports": {
    ".": {
      "types": "./src/priority-buffer.d.ts",
      "default": "./src/priority-buffer.js"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc",
    "test": "node --test 'test/**/*.test.js'",
    "check": "pnpm run check:types && pnpm run build && pnpm test",
    "validate:package": "npx -y publint && npx -y @arethetypeswrong/cli --pack . --profile esm-only",
    "release": "changelogen --release --no-github"
  },
  "dependencies": {
    "@toolbuilder/list": "^1.2.4"
  },
  "devDependencies": {
    "@toolbuilder/ring-buffer": "^1.2.3",
    "@toolbuilder/ring-buffer-tests": "^0.1.4",
    "@types/node": "^26.6.5",
    "changelogen": "^0.6.2",
    "typescript": "^5.6.3"
  }
}
